{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FraudSignal",
  "type": "object",
  "required": ["id", "signal_type", "value_class", "confidence", "first_seen", "last_verified", "sources"],
  "properties": {
    "id": {"type": "string"},
    "signal_type": {"type": "string"},
    "value_class": {"type": "string", "enum": ["domain","url","phone","email","ip","asn","account","beneficiary","merchant","device","wallet","telecom-event","behavior","content-provenance","other"]},
    "confidence": {"type": "string", "enum": ["confirmed","high","medium","low","unverified"]},
    "severity": {"type": "string", "enum": ["informational","low","medium","high","critical"]},
    "first_seen": {"type": "string", "format": "date-time"},
    "last_seen": {"type": ["string","null"], "format": "date-time"},
    "last_verified": {"type": "string", "format": "date"},
    "disposition": {"type": "string", "enum": ["unknown","suspicious","confirmed-fraud","false-positive","expired","revoked"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "source_class"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "source_class": {"type": "string"}
        }
      }
    },
    "relationships": {"type": "array", "items": {"type": "string"}},
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["outcome", "timestamp"],
        "properties": {
          "outcome": {"type": "string"},
          "timestamp": {"type": "string", "format": "date-time"},
          "note": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}
