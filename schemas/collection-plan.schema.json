{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FraudIntelligence Collection Plan",
  "type": "object",
  "required": ["id","pir_id","status","coverage","requirements","gaps","review_cycle_days","last_reviewed"],
  "properties": {
    "id": {"type":"string","pattern":"^CP-[A-Z0-9-]+$"},
    "pir_id": {"type":"string"},
    "status": {"type":"string","enum":["active","paused","complete"]},
    "coverage": {"type":"string","enum":["strong","partial","weak","none"]},
    "requirements": {
      "type":"array","minItems":1,
      "items":{"type":"object","required":["id","question","source_types","cadence"],"properties":{
        "id":{"type":"string"},"question":{"type":"string"},"source_types":{"type":"array","items":{"type":"string"}},"cadence":{"type":"string"},"handling":{"type":"string"}
      }}
    },
    "gaps": {"type":"array","items":{"type":"string"}},
    "legal_privacy_notes": {"type":"array","items":{"type":"string"}},
    "review_cycle_days": {"type":"integer","minimum":1},
    "last_reviewed": {"type":"string","format":"date"}
  },
  "additionalProperties": false
}