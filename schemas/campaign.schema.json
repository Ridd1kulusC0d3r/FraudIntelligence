{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FraudIntelligence Campaign",
  "type": "object",
  "required": ["id","name","status","first_seen","actor_refs","objective","targeting","source_refs","confidence","tlp","last_reviewed"],
  "properties": {
    "id": {"type":"string","pattern":"^FI-CAM-[A-Z0-9-]+$"},
    "name": {"type":"string","minLength":3},
    "status": {"type":"string","enum":["active","historical","monitoring","unverified"]},
    "first_seen": {"type":"string","pattern":"^[0-9]{4}(-[0-9]{2})?(-[0-9]{2})?$"},
    "last_seen": {"type":["string","null"],"pattern":"^[0-9]{4}(-[0-9]{2})?(-[0-9]{2})?$"},
    "actor_refs": {"type":"array","minItems":1,"items":{"type":"string"}},
    "objective": {"type":"string","minLength":10},
    "targeting": {"type":"array","minItems":1,"items":{"type":"string"}},
    "regions": {"type":"array","items":{"type":"string"}},
    "behaviors": {"type":"array","items":{"type":"string"}},
    "source_refs": {"type":"array","minItems":1,"items":{"type":"string","format":"uri"}},
    "confidence": {"type":"string","enum":["confirmed","high","medium","low","unverified"]},
    "tlp": {"type":"string","enum":["TLP:RED","TLP:AMBER","TLP:GREEN","TLP:CLEAR"]},
    "last_reviewed": {"type":"string","format":"date"}
  },
  "additionalProperties": true
}